{
	"name": "notiblock",
	"version": "1.1.0",
	"description": "Conditional notification blocks with dashboard widget configuration.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"build",
		"languages",
		"lib",
		"notiblock.php",
		"readme.txt",
		"uninstall.php"
	],
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php --blocks-manifest",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:cli": "wp-env run cli --",
		"format": "wp-scripts format",
		"i18n:pot": "wp-env run cli -- wp i18n make-pot \"wp-content/plugins/$(basename \"$PWD\")\" \"wp-content/plugins/$(basename \"$PWD\")/languages/notiblock.pot\" --domain=notiblock --exclude=node_modules,vendor,build,lib,plans,tests",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/$(basename \"$PWD\") ./vendor/bin/phpunit"
	},
	"devDependencies": {
		"@wordpress/env": "^11.13.0",
		"@wordpress/scripts": "^34.1.0"
	}
}
